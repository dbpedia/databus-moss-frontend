PUBLIC_MOSS_BASE_URL=http://localhost:8080
MOSS_API_SERVER_URL=http://localhost:8080
ORIGIN=http://localhost:5173

AUTH_OIDC_CLIENT_ID=your-client-id
AUTH_OIDC_CLIENT_SECRET=your-client-secret
AUTH_OIDC_ISSUER=https://your-idp/realms/your-realm
AUTH_OIDC_CLIENT_SCOPE="openid profile email"
AUTH_TRUST_HOST=true
AUTH_SECRET=generate-a-long-random-secret

# Optional: override OIDC discovery document URL
# AUTH_OIDC_DISCOVERY_URL=https://your-idp/realms/your-realm/.well-known/openid-configuration

# Optional: outbound HTTP proxy for OIDC / API calls
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,.internal
